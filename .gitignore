.cache
nosetests.xml
coverage.xml
*.cover
*.log
*.tmp

# Logs
*.log

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE
.vscode/
.idea/

# Compiled JavaScript
*.js.map
*.jsx.map
*.ts.map
*.tsx.map

# Temporary files
*.tmp
*.temp
*.bak

# Testing
coverage/
.nyc_output/
istanbul/
.mocha
.jest

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
lib-cov/
